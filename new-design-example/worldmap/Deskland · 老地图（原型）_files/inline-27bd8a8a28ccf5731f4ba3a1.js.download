
// 网站演示：自动摆图标、虚线框选右侧小阵整批拖走、再拖中间的主角，画面重新生长，循环
(function () {
  const rnd = (a, b) => a + Math.random() * (b - a);
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const H2 = () => H - TASKBAR;
  if (typeof applyLayout === 'undefined' || typeof icons === 'undefined') return;
  const requestedLanguage = new URLSearchParams(location.search).get('lang') || 'zh';
  const translations = {"ru":{"回收站":"Корзина","项目资料":"Проекты","2026 报价单.xlsx":"Смета 2026.xlsx","产品需求.docx":"Требования.docx","截图_0927.png":"Снимок_0927.png","合同扫描件.pdf":"Договор.pdf","新建文件夹":"Новая папка","设计素材":"Материалы дизайна","旅行照片":"Фото путешествий","安装包.zip":"Установщик.zip","会议纪要.docx":"Протокол.docx","壁纸灵感":"Идеи для обоев","周报.xlsx":"Отчёт за неделю.xlsx","桌面截图02.png":"Снимок02.png","旧备份":"Старые копии","微信图片.png":"Фото из чата.png","说明书.pdf":"Руководство.pdf","简历.docx":"Резюме.docx","支出表.xlsx":"Расходы.xlsx","压缩备份.zip":"Резервная копия.zip","素材图.png":"Референс.png","下载":"Загрузки","表情包.png":"Стикер.png","工资条.xlsx":"Расчётный лист.xlsx","租房合同.pdf":"Аренда.pdf","日记.docx":"Дневник.docx","桌面截图.png":"Рабочий стол.png"},"es":{"回收站":"Papelera","项目资料":"Proyectos","2026 报价单.xlsx":"Presupuesto 2026.xlsx","产品需求.docx":"Requisitos.docx","截图_0927.png":"Captura_0927.png","合同扫描件.pdf":"Contrato.pdf","新建文件夹":"Nueva carpeta","设计素材":"Recursos de diseño","旅行照片":"Fotos de viajes","安装包.zip":"Instalador.zip","会议纪要.docx":"Acta.docx","壁纸灵感":"Ideas de fondos","周报.xlsx":"Informe semanal.xlsx","桌面截图02.png":"Captura02.png","旧备份":"Copias antiguas","微信图片.png":"Imagen de chat.png","说明书.pdf":"Manual.pdf","简历.docx":"Currículum.docx","支出表.xlsx":"Gastos.xlsx","压缩备份.zip":"Copia de seguridad.zip","素材图.png":"Referencia.png","下载":"Descargas","表情包.png":"Pegatina.png","工资条.xlsx":"Nómina.xlsx","租房合同.pdf":"Alquiler.pdf","日记.docx":"Diario.docx","桌面截图.png":"Escritorio.png"},"pt-BR":{"回收站":"Lixeira","项目资料":"Projetos","2026 报价单.xlsx":"Orçamento 2026.xlsx","产品需求.docx":"Requisitos.docx","截图_0927.png":"Captura_0927.png","合同扫描件.pdf":"Contrato.pdf","新建文件夹":"Nova pasta","设计素材":"Recursos de design","旅行照片":"Fotos de viagens","安装包.zip":"Instalador.zip","会议纪要.docx":"Ata.docx","壁纸灵感":"Ideias de papéis de parede","周报.xlsx":"Relatório semanal.xlsx","桌面截图02.png":"Captura02.png","旧备份":"Backups antigos","微信图片.png":"Imagem do chat.png","说明书.pdf":"Manual.pdf","简历.docx":"Currículo.docx","支出表.xlsx":"Despesas.xlsx","压缩备